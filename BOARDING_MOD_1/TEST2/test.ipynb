   "source": [
    "import numpy as np \n",
    "\n",
    "X = np.array([1,2,3])\n",
    "y = np.array([2, 4, 6])\n",
    "\n",
    "w=0\n",
    "b=0\n",
    "lr = 0.01\n",
    "\n",
    "for _ in range(1000):\n",
    "    y_pred = w * X + b\n",
    "\n",
    "    dw = np.sum(X * (y_pred-y)**2)\n",
    "    db = np.sum((y_pred-y)**2)\n",
    "\n",
    "    w -= lr * dw\n",
    "    b -= lr * db \n",
    "\n",
    "print(w, b)\n"
   ]
